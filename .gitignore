# Wrangler build cache — contains the Cloudflare account id and account name (an email).
# This repo is published via GitHub Pages, so it must not be tracked.
.wrangler/
worker/.wrangler/
worker-strike/.wrangler/

# Local wrangler secrets
.dev.vars
.env
.env.*

# Dependencies (none checked in today, but keeps future installs out)
node_modules/

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp

# Backups
*.bak

# NASA FIRMS API key — never commit
tools/.firms-key

# FIRMS raw response cache — 374 MB of API responses, regenerable
tools/.cache/

# Generated by tests/site/hardware-suite.js, which boots the real page against a
# DOM stub. It removes it again; this is for the run that gets interrupted.
tests/site/hw-probe.js

# The assembled Pages tree. tools/build-pages.js writes it, the deploy check removes it again,
# and the Actions workflow builds it fresh on the runner — it is output, never source, and at
# 21MB it is not something to commit by accident.
_site/
